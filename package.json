{
  "name": "aigenerateadvanture",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "boot": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-up.ps1",
    "serve:local": "powershell -ExecutionPolicy Bypass -File ./scripts/local-prod-start.ps1",
    "autostart:install": "powershell -ExecutionPolicy Bypass -File ./scripts/install-autostart-task.ps1",
    "autostart:remove": "powershell -ExecutionPolicy Bypass -File ./scripts/remove-autostart-task.ps1",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --pass-with-no-tests",
    "prisma:generate": "powershell -ExecutionPolicy Bypass -File ./scripts/prisma-generate-safe.ps1",
    "typecheck": "tsc --noEmit",
    "gitnexus:analyze": "powershell -ExecutionPolicy Bypass -File ./scripts/gitnexus-analyze-safe.ps1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@prisma/client": "^6.19.3",
    "mammoth": "^1.12.0",
    "next": "^15.3.0",
    "openai": "^6.34.0",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.52.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
