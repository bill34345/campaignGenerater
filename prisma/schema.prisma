generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Campaign {
  id                  String           @id @default(cuid())
  name                String
  system              String           @default("5e")
  partyLevel          Int
  tone                String
  contentConstraints  String?
  llmProvider         String           @default("openai_responses")
  llmApiKey           String?
  llmModel            String?
  llmBaseUrl          String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  importBatches       ImportBatch[]
  importBatchFiles    ImportBatchFile[]
  sourceDocuments     SourceDocument[]
  documentChunks      DocumentChunk[]
  canonFacts          CanonFact[]
  canonicalEntries    CanonicalEntry[]
  campaignDeltas      CampaignDelta[]
  townProfiles        TownProfile[]
  questRequests       QuestRequest[]
  questDrafts         QuestDraft[]
}

model ImportBatch {
  id                String            @id @default(cuid())
  campaignId        String
  status            String            @default("staged")
  defaultSourceType String            @default("custom_reference")
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  campaign          Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  files             ImportBatchFile[]
  sourceDocuments   SourceDocument[]

  @@unique([id, campaignId])
  @@index([campaignId, createdAt])
  @@index([campaignId, status])
}

model ImportBatchFile {
  id            String      @id @default(cuid())
  importBatchId String
  campaignId    String
  originalName  String
  storedPath    String?
  mimeType      String?
  checksum      String?
  sizeBytes     Int?
  sourceType    String
  status        String      @default("staged")
  errorCode     String?
  errorMessage  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  importBatch   ImportBatch @relation(fields: [importBatchId, campaignId], references: [id, campaignId], onDelete: Cascade)
  campaign      Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([importBatchId, createdAt])
  @@index([campaignId, status])
}

model SourceDocument {
  id              String          @id @default(cuid())
  campaignId      String
  importBatchId   String?
  originalName    String
  storedPath      String
  mimeType        String
  checksum        String
  sourceType      String          @default("custom_reference")
  processingStatus String         @default("processed")
  extractionError String?
  extractedText   String?
  pageCount       Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  campaign        Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  importBatch     ImportBatch?    @relation(fields: [importBatchId, campaignId], references: [id, campaignId], onDelete: NoAction)
  chunks          DocumentChunk[]
  canonFacts      CanonFact[]

  @@index([campaignId, createdAt])
  @@index([importBatchId])
  @@index([campaignId, processingStatus])
}

model DocumentChunk {
  id                String         @id @default(cuid())
  campaignId        String
  sourceDocumentId  String
  chunkIndex        Int
  pageStart         Int?
  pageEnd           Int?
  content           String
  tokenCount        Int?
  checksum          String?
  createdAt         DateTime       @default(now())
  campaign          Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sourceDocument    SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  canonFacts        CanonFact[]

  @@index([sourceDocumentId, chunkIndex])
  @@index([campaignId, createdAt])
}

model CanonFact {
  id               String          @id @default(cuid())
  campaignId       String
  sourceDocumentId String?
  documentChunkId  String?
  subject          String
  factType         String
  value            String
  status           String          @default("active")
  priority         Int             @default(0)
  confidence       Float?
  evidence         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  campaign         Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sourceDocument   SourceDocument?  @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  documentChunk    DocumentChunk?   @relation(fields: [documentChunkId], references: [id], onDelete: SetNull)
  canonicalEntries CanonicalEntrySourceFact[]
  campaignDeltas   CampaignDelta[]  @relation("CanonFactAsSourceFact")

  @@unique([id, campaignId])
  @@index([campaignId, subject])
  @@index([campaignId, factType])
}

model CanonicalEntry {
  id             String                     @id @default(cuid())
  campaignId     String
  subject        String
  factType       String
  canonicalValue String
  notes          String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  campaign       Campaign                   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sourceFacts    CanonicalEntrySourceFact[]

  @@unique([id, campaignId])
  @@unique([campaignId, subject, factType])
  @@index([campaignId, subject])
  @@index([campaignId, factType])
}

model CanonicalEntrySourceFact {
  id               String         @id @default(cuid())
  campaignId       String
  canonicalEntryId String
  canonFactId      String
  createdAt        DateTime       @default(now())
  canonicalEntry   CanonicalEntry @relation(fields: [canonicalEntryId, campaignId], references: [id, campaignId], onDelete: Cascade)
  canonFact        CanonFact      @relation(fields: [canonFactId, campaignId], references: [id, campaignId], onDelete: Cascade)

  @@unique([canonicalEntryId, canonFactId])
  @@index([canonFactId])
}

model CampaignDelta {
  id               String     @id @default(cuid())
  campaignId       String
  sourceFactId     String?
  deltaType        String
  summary          String
  createdAt        DateTime   @default(now())
  campaign         Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sourceFact       CanonFact? @relation("CanonFactAsSourceFact", fields: [sourceFactId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
}

model TownProfile {
  id               String          @id @default(cuid())
  campaignId       String
  name             String
  vibe             String?
  tension          String?
  notes            String?
  questHooks       Json
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  campaign         Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  questRequests    QuestRequest[]

  @@unique([campaignId, name])
  @@index([campaignId, createdAt])
}

model QuestRequest {
  id                String       @id @default(cuid())
  campaignId        String
  townProfileId     String?
  requestMode       String       @default("standard")
  generationStatus  String       @default("queued")
  generationStage   String       @default("queued")
  generationProgressMessage String?
  generationPreviewText String?
  generationStartedAt DateTime?
  generationCompletedAt DateTime?
  generationFailedAt DateTime?
  generationLastErrorCode String?
  generationLastErrorMessage String?
  townName          String
  locale            String       @default("zh")
  townVibe          String?
  localTension      String?
  questType         String?
  mainPlotRelation  String?
  desiredLength     String?
  extraContext      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  campaign          Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  townProfile       TownProfile? @relation(fields: [townProfileId], references: [id], onDelete: SetNull)
  questDraft        QuestDraft?

  @@index([campaignId, createdAt])
  @@index([townProfileId])
  @@index([campaignId, generationStatus, createdAt])
}

model QuestDraft {
  id                 String        @id @default(cuid())
  campaignId         String
  questRequestId     String?       @unique
  locale             String        @default("zh")
  generationMode     String        @default("unknown")
  generationProvider String?
  generationModel    String?
  fallbackReason     String?
  generationErrorCode String?
  title              String
  premise            String
  hook               String
  scenes             Json
  npcs               Json
  encounters         Json
  rewards            Json
  returnToMainPlot   String
  gmSummary          String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  campaign          Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  questRequest      QuestRequest? @relation(fields: [questRequestId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
}
